# Copier ce fichier en .env si vous voulez documenter votre configuration locale.
# Les scripts PM2 ne sourcent pas automatiquement .env ; reportez les valeurs utiles
# dans ecosystem.config.cjs ou lancez pm2 avec un environnement exporte.

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
FLASK_SECRET_KEY=change-this-local-secret
DISCORD_API_BASE_URL=https://discord.com/api/v9
DISCORD_REQUEST_TIMEOUT=10
DISCORD_MAX_RETRIES=3
DISCORD_REQUEST_SPACING=0.25
DISCORD_SEARCH_MAX_PAGES=0
DISCORD_SEARCH_INDEX_RETRIES=3
CHANNEL_MESSAGE_PAGE_SIZE=20
TASK_MESSAGE_LOG_LIMIT=1000
DM_EXPORT_MAX_PAGES=0
DM_EXPORT_ASSET_TIMEOUT=20
DM_EXPORT_MAX_ASSET_BYTES=26214400
AUTOBUMPER_ENABLED=1
AUTOBUMPER_DISBOARD_APP_ID=302050872383242240
AUTOBUMPER_CHECK_INTERVAL=10
AUTOBUMPER_BUMP_INTERVAL=7200
AUTOBUMPER_RETRY_DELAY=60
AUTOBUMPER_MAX_RETRIES=3
AUTOBUMPER_MAX_DUE_PER_CYCLE=1
AUTOBUMPER_COMMAND_CACHE_TTL=900
AUTOBUMPER_RESPONSE_POLL_SECONDS=15
AUTOBUMPER_RESPONSE_POLL_INTERVAL=2
AUTOBUMPER_COOLDOWN_MARGIN=5
AUTOBUMPER_DELAY_SLOTS=12
AUTOBUMPER_DELAY_STEP_MINUTES=10
MESSAGE_SCRAPER_DEFAULT_MAX_PAGES=0
MESSAGE_SCRAPER_PREVIEW_LIMIT=300
ACCOUNT_BACKUP_SCHEDULER_ENABLED=1
ACCOUNT_BACKUP_SCHEDULER_CHECK_INTERVAL=60
SELFBOT_TOOLS_WORKER_ENABLED=1
SELFBOT_TOOLS_SPY_INTERVAL=15
SELFBOT_TOOLS_ANTIGROUP_INTERVAL=30
SELFBOT_SPY_MAX_CHANNELS=50
SELFBOT_SPY_MESSAGE_LOOKBACK=25
